---
/**
 * Footer – ime, kratek opis, stolpci povezav, kontakt in pravne povezave.
 */
import type { LinkItem } from '../types.ts';

interface Props {
  siteName: string;
  tagline?: string;
  columns?: Array<{ title: string; links: LinkItem[] }>;
  legal?: LinkItem[];
  /** Pravni podatki podjetja (naziv, matična, davčna). */
  companyInfo?: string;
  copyrightName?: string;
}

const { siteName, tagline, columns = [], legal = [], companyInfo, copyrightName = siteName } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-surface-inverse py-16 text-on-surface-inverse">
  <div class="wrap grid gap-12 md:grid-cols-4">
    <div class="md:col-span-2">
      <p class="font-heading text-xl font-bold">{siteName}</p>
      {tagline && <p class="mt-3 max-w-measure text-on-surface-inverse-muted">{tagline}</p>}
      <slot />
    </div>
    {
      columns.map((col) => (
        <nav aria-label={col.title}>
          <p class="text-sm font-semibold tracking-wide uppercase text-on-surface-inverse-muted">{col.title}</p>
          <ul class="mt-4 space-y-3">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="hover:underline hover:underline-offset-4">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div
    class="wrap mt-12 flex flex-col gap-4 border-t border-on-surface-inverse-muted/30 pt-8 text-sm text-on-surface-inverse-muted md:flex-row md:justify-between"
  >
    <p>© {year} {copyrightName}{companyInfo && <span> · {companyInfo}</span>}</p>
    {
      legal.length > 0 && (
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {legal.map((link) => (
            <li>
              <a href={link.href} class="hover:text-on-surface-inverse">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>
