---
/**
 * Features (Storitve) – mreža kartic z naslovom in opisom.
 */
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  items: Array<{ title: string; text: string; href?: string }>;
}

const { id = 'storitve', eyebrow, title, intro, items } = Astro.props;
---

<section id={id} class="bg-surface-alt py-section" aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <div class="max-w-measure">
      {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
      <h2 id={`${id}-title`} class="text-3xl font-bold">{title}</h2>
      {intro && <p class="mt-4 text-lg text-on-surface-muted">{intro}</p>}
    </div>
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item, i) => (
          <li class="flex flex-col rounded-md bg-surface p-8 shadow-card">
            <span aria-hidden="true" class="text-sm font-semibold tracking-wide text-accent">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 text-xl font-semibold">
              {item.href ? (
                <a href={item.href} class="hover:text-primary">
                  {item.title}
                </a>
              ) : (
                item.title
              )}
            </h3>
            <p class="mt-3 text-on-surface-muted">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
