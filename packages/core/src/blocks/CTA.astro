---
/**
 * CTA – poziv k dejanju na barvi `primary`.
 */
import type { LinkItem } from '../types.ts';

interface Props {
  id?: string;
  title: string;
  text?: string;
  cta: LinkItem;
  secondary?: LinkItem;
}

const { id = 'cta', title, text, cta, secondary } = Astro.props;
---

<section id={id} class="bg-surface py-section" aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <div class="rounded-lg bg-primary px-8 py-16 text-center text-on-primary sm:px-16">
      <h2 id={`${id}-title`} class="mx-auto max-w-measure text-3xl font-bold">{title}</h2>
      {text && <p class="mx-auto mt-4 max-w-measure text-lg">{text}</p>}
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href={cta.href} class="btn btn-inverse">{cta.label}</a>
        {
          secondary && (
            <a href={secondary.href} class="btn border-on-primary text-on-primary">
              {secondary.label}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
