---
/**
 * <SEO> – vse meta oznake za <head>: title, description, canonical, robots, Open Graph,
 * Twitter kartica, hreflang in JSON-LD. Uporablja ga <BaseLayout>; neposredno samo pri lastnem layoutu.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { serializeJsonLd, type JsonLd } from './jsonld.ts';

export interface Alternate {
  /** BCP 47 (`sl`, `en`, `de-AT`) ali `x-default`. */
  hreflang: string;
  href: string | URL;
}

export interface SEOProps {
  title: string;
  /** 50–160 znakov; prikaže se v rezultatih iskanja. */
  description: string;
  siteName: string;
  /** `%s | Ime strani`; za domačo stran nastavi `'%s'`. */
  titleTemplate?: string;
  /** Privzeto trenutna pot na `site` iz astro.config. */
  canonical?: string | URL;
  /** Lokalna slika (pretvori se v 1200×630 JPG) ali absoluten URL. */
  image?: ImageMetadata | string;
  imageAlt?: string;
  type?: 'website' | 'article';
  /** `sl_SI`, `en_US` … Privzeto iz `lang`. */
  locale?: string;
  lang?: string;
  alternates?: Alternate[];
  noindex?: boolean;
  article?: { publishedTime: Date; modifiedTime?: Date; author?: string; tags?: string[] };
  twitterSite?: string;
  jsonLd?: JsonLd | JsonLd[];
}

type Props = SEOProps;

const OG_LOCALES: Record<string, string> = { sl: 'sl_SI', en: 'en_US', de: 'de_DE', hr: 'hr_HR', it: 'it_IT' };

const {
  title,
  description,
  siteName,
  titleTemplate = `%s | ${siteName}`,
  canonical,
  image,
  imageAlt,
  type = 'website',
  lang = 'sl',
  locale = OG_LOCALES[lang] ?? lang,
  alternates = [],
  noindex = false,
  article,
  twitterSite,
  jsonLd,
} = Astro.props;

const site = Astro.site!;
const fullTitle = titleTemplate.replace('%s', title);
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, site);

let ogImage: string | undefined;
let ogImageSize: { width: number; height: number } | undefined;
if (typeof image === 'string') {
  ogImage = new URL(image, site).href;
} else if (image) {
  const og = await getImage({ src: image, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
  ogImage = new URL(og.src, site).href;
  ogImageSize = { width: 1200, height: 630 };
}

if (import.meta.env.DEV && (description.length < 50 || description.length > 160)) {
  console.warn(`[SEO] description za "${title}" ima ${description.length} znakov (priporočeno 50–160).`);
}
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl.href} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
{alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={new URL(alt.href, site).href} />)}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl.href} />
<meta property="og:locale" content={locale} />
{
  alternates
    .filter((alt) => alt.hreflang !== 'x-default' && alt.hreflang !== lang)
    .map((alt) => <meta property="og:locale:alternate" content={OG_LOCALES[alt.hreflang] ?? alt.hreflang} />)
}
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImageSize && <meta property="og:image:width" content={String(ogImageSize.width)} />}
{ogImageSize && <meta property="og:image:height" content={String(ogImageSize.height)} />}
{ogImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{
  article && (
    <>
      <meta property="article:published_time" content={article.publishedTime.toISOString()} />
      {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
      {article.author && <meta property="article:author" content={article.author} />}
      {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    </>
  )
}

<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
{twitterSite && <meta name="twitter:site" content={twitterSite} />}

{
  (Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []).map((data) => (
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(data)} />
  ))
}
