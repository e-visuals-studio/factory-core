{
  "$description": "Privzeta tema Website Factory. Stranka jo prepiše s svojim tokens.json (izvoz iz Figma Variables / Tokens Studio).",
  "color": {
    "surface": {
      "$type": "color",
      "$value": "#faf8f5"
    },
    "surface-alt": {
      "$type": "color",
      "$value": "#f1ece4"
    },
    "surface-inverse": {
      "$type": "color",
      "$value": "#1c1917"
    },
    "on-surface": {
      "$type": "color",
      "$value": "#1c1917"
    },
    "on-surface-muted": {
      "$type": "color",
      "$value": "#57534e"
    },
    "on-surface-inverse": {
      "$type": "color",
      "$value": "#f5f5f4"
    },
    "on-surface-inverse-muted": {
      "$type": "color",
      "$value": "#b5afa9"
    },
    "primary": {
      "$type": "color",
      "$value": "#1f4d3a"
    },
    "on-primary": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "accent": {
      "$type": "color",
      "$value": "#b4400d"
    },
    "on-accent": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "border": {
      "$type": "color",
      "$value": "#d6d3d1"
    },
    "focus": {
      "$type": "color",
      "$value": "{color.accent}"
    }
  },
  "font": {
    "body": {
      "$type": "fontFamily",
      "$value": [
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "Roboto",
        "sans-serif"
      ]
    },
    "heading": {
      "$type": "fontFamily",
      "$value": "{font.body}"
    }
  },
  "text": {
    "sm": {
      "$type": "dimension",
      "$value": "0.875rem"
    },
    "base": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "lg": {
      "$type": "dimension",
      "$value": "1.125rem"
    },
    "xl": {
      "$type": "dimension",
      "$value": "1.375rem"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "1.75rem"
    },
    "3xl": {
      "$type": "dimension",
      "$value": "2.25rem"
    },
    "4xl": {
      "$type": "dimension",
      "$value": "clamp(2.25rem, 1.6rem + 2.8vw, 3.5rem)"
    }
  },
  "font-weight": {
    "normal": {
      "$type": "fontWeight",
      "$value": 400
    },
    "medium": {
      "$type": "fontWeight",
      "$value": 500
    },
    "semibold": {
      "$type": "fontWeight",
      "$value": 600
    },
    "bold": {
      "$type": "fontWeight",
      "$value": 700
    }
  },
  "leading": {
    "tight": {
      "$type": "number",
      "$value": 1.15
    },
    "snug": {
      "$type": "number",
      "$value": 1.35
    },
    "normal": {
      "$type": "number",
      "$value": 1.6
    }
  },
  "tracking": {
    "tight": {
      "$type": "dimension",
      "$value": "-0.02em"
    },
    "normal": {
      "$type": "dimension",
      "$value": "0em"
    },
    "wide": {
      "$type": "dimension",
      "$value": "0.08em"
    }
  },
  "spacing": {
    "base": {
      "$type": "dimension",
      "$value": "0.25rem"
    },
    "section": {
      "$type": "dimension",
      "$value": "clamp(4rem, 3rem + 4vw, 7rem)"
    },
    "gutter": {
      "$type": "dimension",
      "$value": "clamp(1.25rem, 0.75rem + 2vw, 2.5rem)"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "0.375rem"
    },
    "md": {
      "$type": "dimension",
      "$value": "0.75rem"
    },
    "lg": {
      "$type": "dimension",
      "$value": "1.25rem"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": "0 1px 2px rgb(28 25 23 / 0.06), 0 8px 24px rgb(28 25 23 / 0.06)"
    }
  },
  "container": {
    "content": {
      "$type": "dimension",
      "$value": "72rem"
    },
    "measure": {
      "$type": "dimension",
      "$value": "42rem"
    }
  },
  "ease": {
    "standard": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "in": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.3, 0, 1, 1)"
    },
    "out": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0, 0, 0, 1)"
    },
    "emphasized": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.05, 0.7, 0.1, 1)"
    }
  },
  "duration": {
    "instant": {
      "$type": "duration",
      "$value": "80ms"
    },
    "fast": {
      "$type": "duration",
      "$value": "150ms"
    },
    "base": {
      "$type": "duration",
      "$value": "250ms"
    },
    "slow": {
      "$type": "duration",
      "$value": "400ms"
    },
    "slower": {
      "$type": "duration",
      "$value": "600ms"
    }
  }
}
