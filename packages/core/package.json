{
  "name": "@e-visuals-studio/core",
  "version": "0.3.1",
  "description": "Jedro Website Factory: SEO, layouti, bloki in tokeni za Astro 7 + Tailwind 4",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e-visuals-studio/factory-core.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "astro-component",
    "astro-integration"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./integration": {
      "types": "./dist/integration.d.ts",
      "default": "./dist/integration.js"
    },
    "./brief": {
      "types": "./dist/brief/index.d.ts",
      "default": "./dist/brief/index.js"
    },
    "./image-service": {
      "types": "./dist/image/service.d.ts",
      "default": "./dist/image/service.js"
    },
    "./tokens": {
      "types": "./dist/tokens/build-tokens.d.ts",
      "default": "./dist/tokens/build-tokens.js"
    },
    "./layouts/*": "./src/layouts/*",
    "./blocks/*": "./src/blocks/*",
    "./seo/*": "./src/seo/*",
    "./analytics/*": "./src/analytics/*",
    "./tokens.default.json": "./tokens.default.json"
  },
  "bin": {
    "factory-tokens": "./dist/tokens/cli.js",
    "factory-check-tokens": "./dist/cli/check-tokens.js",
    "factory-check-todo": "./dist/cli/check-todo.js",
    "factory-placeholders": "./dist/cli/placeholders.js"
  },
  "files": [
    "dist",
    "src",
    "tokens.default.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "peerDependencies": {
    "astro": "^7.2.8"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "vanilla-cookieconsent": "^3.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "astro": "^7.4.2",
    "typescript": "^5.9.3"
  }
}
