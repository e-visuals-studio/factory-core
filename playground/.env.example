# Analitika v playgroundu: none (privzeto) | umami | plausible | ga4
# Vrednosti spodaj so namerno lažne. Prave ID-je nastaviš samo v okolju (CI, Cloudflare Pages), nikoli v repozitoriju.
# Uporaba: set -a; . playground/.env; set +a; pnpm build
ANALYTICS_PROVIDER=none

UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000

PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js
PLAUSIBLE_DOMAIN=playground.e-visuals.si

GA4_MEASUREMENT_ID=G-XXXXXXXXXX
