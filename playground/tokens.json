{
  "$description": "Tokeni stranke (primer). Prepišejo privzeto temo iz @e-visuals-studio/core.",
  "color": {
    "surface": {
      "$type": "color",
      "$value": "#fbf9f6"
    },
    "surface-alt": {
      "$type": "color",
      "$value": "#f2ede6"
    },
    "surface-inverse": {
      "$type": "color",
      "$value": "#22201c"
    },
    "on-surface": {
      "$type": "color",
      "$value": "#22201c"
    },
    "on-surface-muted": {
      "$type": "color",
      "$value": "#5c564e"
    },
    "on-surface-inverse": {
      "$type": "color",
      "$value": "#f5f2ee"
    },
    "on-surface-inverse-muted": {
      "$type": "color",
      "$value": "#b8b0a6"
    },
    "primary": {
      "$type": "color",
      "$value": "#6b3410"
    },
    "on-primary": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "accent": {
      "$type": "color",
      "$value": "#9a4a12"
    },
    "on-accent": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "border": {
      "$type": "color",
      "$value": "#ddd5ca"
    },
    "focus": {
      "$type": "color",
      "$value": "{color.primary}"
    }
  },
  "font": {
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Inter",
        "system-ui",
        "sans-serif"
      ]
    },
    "heading": {
      "$type": "fontFamily",
      "$value": "{font.body}"
    }
  },
  "text": {
    "sm": {
      "$type": "dimension",
      "$value": "0.875rem"
    },
    "base": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "lg": {
      "$type": "dimension",
      "$value": "1.125rem"
    },
    "xl": {
      "$type": "dimension",
      "$value": "1.375rem"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "1.75rem"
    },
    "3xl": {
      "$type": "dimension",
      "$value": "clamp(1.875rem, 1.5rem + 1.6vw, 2.5rem)"
    },
    "4xl": {
      "$type": "dimension",
      "$value": "clamp(2.25rem, 1.5rem + 3.2vw, 3.75rem)"
    }
  },
  "font-weight": {
    "normal": {
      "$type": "fontWeight",
      "$value": 400
    },
    "medium": {
      "$type": "fontWeight",
      "$value": 500
    },
    "semibold": {
      "$type": "fontWeight",
      "$value": 600
    },
    "bold": {
      "$type": "fontWeight",
      "$value": 700
    }
  },
  "leading": {
    "tight": {
      "$type": "number",
      "$value": 1.12
    },
    "snug": {
      "$type": "number",
      "$value": 1.35
    },
    "normal": {
      "$type": "number",
      "$value": 1.65
    }
  },
  "tracking": {
    "tight": {
      "$type": "dimension",
      "$value": "-0.025em"
    },
    "normal": {
      "$type": "dimension",
      "$value": "0em"
    },
    "wide": {
      "$type": "dimension",
      "$value": "0.1em"
    }
  },
  "spacing": {
    "base": {
      "$type": "dimension",
      "$value": "0.25rem"
    },
    "section": {
      "$type": "dimension",
      "$value": "clamp(4rem, 3rem + 4vw, 7rem)"
    },
    "gutter": {
      "$type": "dimension",
      "$value": "clamp(1.25rem, 0.75rem + 2vw, 2.5rem)"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "0.25rem"
    },
    "md": {
      "$type": "dimension",
      "$value": "0.5rem"
    },
    "lg": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": "0 1px 2px rgb(34 32 28 / 0.06), 0 10px 30px rgb(34 32 28 / 0.07)"
    }
  },
  "container": {
    "content": {
      "$type": "dimension",
      "$value": "72rem"
    },
    "measure": {
      "$type": "dimension",
      "$value": "40rem"
    }
  },
  "ease": {
    "standard": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "in": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.3, 0, 1, 1)"
    },
    "out": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0, 0, 0, 1)"
    },
    "emphasized": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.05, 0.7, 0.1, 1)"
    }
  },
  "duration": {
    "instant": {
      "$type": "duration",
      "$value": "80ms"
    },
    "fast": {
      "$type": "duration",
      "$value": "150ms"
    },
    "base": {
      "$type": "duration",
      "$value": "250ms"
    },
    "slow": {
      "$type": "duration",
      "$value": "400ms"
    },
    "slower": {
      "$type": "duration",
      "$value": "600ms"
    }
  }
}
